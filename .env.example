# ---------------------------------------------------------------------------
# AusbildungTracker – frontend environment variables
# Copy this file to `.env.local` and fill in the values from
# Firebase Console → Project settings → Your apps → SDK setup and configuration.
# `.env.local` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Demo mode: run the app without any Firebase project using seeded German demo
# data persisted in localStorage (no Firestore, Gmail or Vertex AI). Set to
# "true" to enable – ideal for a public portfolio deployment (e.g. on Vercel).
NEXT_PUBLIC_DEMO_MODE=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=azubitracker.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=azubitracker
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=azubitracker.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Region the Cloud Functions are deployed to.
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional: deep-link used in e-mail notifications / OAuth redirect back into
# the app. Falls back to window.location.origin when empty.
NEXT_PUBLIC_APP_URL=
