# ---------------------------------------------------------------------------
# AusbildungTracker – Cloud Functions environment variables
# Copy this file to `functions/.env` and fill in the values.
# `functions/.env` is git-ignored and must never be committed.
#
# For production you can additionally move GMAIL_CLIENT_SECRET into Secret
# Manager (see README → "Secrets (optional but recommended)").
# ---------------------------------------------------------------------------

# --- Google Cloud / Vertex AI ---------------------------------------------
# NOTE: the project id is picked up automatically at runtime (GCLOUD_PROJECT).
# `GOOGLE_*` keys are reserved by Firebase and must not be set here.
# Location used for Vertex AI (Gemini).
# Gemini 3.x models (including gemini-3.6-flash) are only served from the
# `global` endpoint; regional endpoints like us-central1 return 404.
VERTEX_LOCATION=global

# Gemini model used for mail classification + research.
# Verified available models: gemini-3.6-flash, gemini-3.5-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.6-flash

# --- Gmail OAuth -----------------------------------------------------------
# OAuth 2.0 Client (type: Web application) from Google Cloud Console.
# Authorised redirect URI must be:
#   https://us-central1-azubitracker.cloudfunctions.net/gmailOAuthCallback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Where the OAuth callback sends the browser back to after connecting Gmail.
# Production is the Firebase Hosting URL; use http://localhost:3000 for local
# function emulation.
APP_URL=https://azubitracker.web.app

# --- Sync behaviour --------------------------------------------------------
# How many days back the very first sync looks, and how many mails it pulls.
FIRST_SYNC_LOOKBACK_DAYS=365
MAX_MESSAGES_PER_SYNC=200

# Absolute lower bound for the mail scan window (YYYY-MM-DD). Mail older than
# this date is never processed – not on initial sync, fullSync or sinceDate.
# Set this to the day the tracker was started; older applications are ignored.
SYNC_START_DATE=2026-09-01

# Gmail search query used to pre-filter the mailbox before the AI sees a mail.
GMAIL_SEARCH_QUERY=(Bewerbung OR Bewerbungsbestätigung OR Vorstellungsgespräch OR Absage OR Zusage OR Einladung OR "Assessment Center" OR Ausbildungsplatz OR "Ausbildung" OR Bewerbungsgespräch)

# Enable Google Search grounding when researching companies / Ausbildungen.
ENABLE_WEB_RESEARCH=true

# --- Automatic research ----------------------------------------------------
# How many applications the hourly enrichment job researches per run. The
# candidate query itself is capped at 20 applications.
ENRICH_BATCH_SIZE=3

# Set to false to disable the `enrichApplicationsScheduled` job entirely.
ENABLE_AUTO_ENRICHMENT=true
